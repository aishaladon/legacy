ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret

# ── Data backend ─────────────────────────────────────────────────────
DB_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database
MYSQL_POOL=5

PORT=3000

# ── Archive search APIs ──────────────────────────────────────────────
NARA_API_KEY=your_nara_api_key_here
FAMILYSEARCH_CLIENT_ID=your_familysearch_client_id_here
DPLA_API_KEY=your_dpla_api_key_here

# ── NAS file storage (Synology) ────────────────────────────────────
NAS_HOST=https://quickconnect.to/legacyarchives
NAS_USER=kriogriot
NAS_PASS=your_nas_password_here
NAS_FOLDER=/kriogriot-uploads

# ── Email ────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
