# Copy this file to .env and fill in your values. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=govcon
DB_USER=aishaladon
DB_PASSWORD=your_db_password

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-before-deploying
PORT=3000
# Your app's public URL, no trailing slash — used to build clickable links
# (e.g. "View in govcon" links in the Daily Opportunity Digest email).
APP_URL=https://govcon.legacypnp.ltd

# ── App login ─────────────────────────────────────────────────────────────────
# Initial admin credentials — change password immediately after first login
ADMIN_USERNAME=aisha
ADMIN_PASSWORD=change-me-on-first-login

# ── Email (IMAP — for parsing info@legacypnp.ltd) ────────────────────────────
IMAP_HOST=mail.legacypnp.ltd
IMAP_PORT=993
IMAP_USERNAME=info@legacypnp.ltd
IMAP_PASSWORD=your_email_password
IMAP_USE_SSL=true

# ── Email (SMTP — for sending daily digest) ──────────────────────────────────
SMTP_HOST=mail.legacypnp.ltd
SMTP_PORT=587
SMTP_USERNAME=info@legacypnp.ltd
SMTP_PASSWORD=your_email_password
SMTP_USE_TLS=true
DIGEST_FROM=info@legacypnp.ltd

# ── SAM.gov API ───────────────────────────────────────────────────────────────
# Free API key from sam.gov/api
SAM_API_KEY=your_sam_gov_api_key

# If Hostinger's outbound connections to api.sam.gov are blocked (they were —
# see RELAY.md), set these instead to route SAM.gov Search through a small
# Cloudflare Worker relay. When SAM_RELAY_URL is set, it's used instead of a
# direct SAM.gov call, and SAM_API_KEY above is no longer needed (the key
# lives in the Worker instead — see RELAY.md).
# SAM_RELAY_URL=https://sam-relay.your-subdomain.workers.dev
# SAM_RELAY_SECRET=a-random-string-you-make-up

# ── Claude / Anthropic API ────────────────────────────────────────────────────
# Not required here — the Claude API key is configured in-app under
# Settings → API Keys, and is stored in the database instead.

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=America/Los_Angeles
