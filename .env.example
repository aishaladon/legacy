ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# ── Data backend ─────────────────────────────────────────────────────
DB_DRIVER=mysql

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database
MYSQL_POOL=5

PORT=3000

# ── Archive search APIs ──────────────────────────────────────────────
# NARA Catalog API -- register at catalog.archives.gov -- 10,000 calls/month free
NARA_API_KEY=your_nara_api_key_here
# FamilySearch -- register free at developers.familysearch.org
FAMILYSEARCH_CLIENT_ID=your_familysearch_client_id_here
# DPLA -- get free key at dp.la/info/developers
DPLA_API_KEY=your_dpla_api_key_here

# ── Email ────────────────────────────────────────────────────────
# Resend -- https://resend.com
RESEND_API_KEY=your_resend_api_key_here
