<div class="page-header">
  <h2>Claude Assistant</h2>
  <p class="page-desc">Paste an opportunity or RFP for a fit evaluation, ask for a proposal outline, or research an agency — Claude has your company profile, capability statement, and active pipeline as context.</p>
</div>

<div id="claudeChat" class="claude-page">
  <div class="claude-chat-header">
    <span>Conversation</span>
    <div class="claude-chat-header-actions">
      <button id="claudeChatClear" class="claude-chat-toggle" title="Clear conversation" type="button">&#8635; Clear</button>
    </div>
  </div>
  <div id="claudeChatMessages" class="claude-chat-messages"></div>
  <div id="claudeAttachmentChip" class="claude-attachment-chip" style="display:none;">
    <span id="claudeAttachmentName"></span>
    <button id="claudeAttachmentRemove" type="button" title="Remove attachment">&times;</button>
  </div>
  <div class="claude-chat-input-area">
    <input type="file" id="claudeFileInput" accept=".txt,.pdf,.docx" style="display:none;">
    <button id="claudeAttachBtn" class="btn btn-secondary" type="button" title="Attach a .txt, .pdf, or .docx file">&#128206;</button>
    <textarea id="claudeInput" placeholder="Ask Claude about this opportunity, copy/paste a bid, or get research..."></textarea>
    <button id="claudeSend" class="btn btn-primary">Send</button>
  </div>
</div>

<script src="/js/claude-chat.js"></script>
