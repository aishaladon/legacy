<div class="page-header">
  <h2><%= title %></h2>
  <a href="/grants" class="btn-link">Cancel</a>
</div>

<form action="/grants" method="POST" class="form-card">
  <h3 class="form-section-title">Basic Info</h3>
  <div class="form-row">
    <div class="form-group form-group--wide">
      <label>Title <span class="req">*</span></label>
      <input type="text" name="title" required>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label>Status</label>
      <select name="status">
        <% ['New','Reviewing','Pursuing','Submitted','Awarded','Not Pursuing','Closed'].forEach(function(s) { %>
          <option value="<%= s %>"><%= s %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label>Region</label>
      <input type="text" name="region">
    </div>
    <div class="form-group">
      <label>Posted Date</label>
      <input type="date" name="posted_date">
    </div>
    <div class="form-group">
      <label>Due Date</label>
      <input type="date" name="due_date">
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label>Amount Min ($)</label>
      <input type="number" name="amount_min">
    </div>
    <div class="form-group">
      <label>Amount Max ($)</label>
      <input type="number" name="amount_max">
    </div>
    <div class="form-group form-group--wide">
      <label>Source URL</label>
      <input type="url" name="source_url">
    </div>
  </div>

  <h3 class="form-section-title">Grant Details</h3>
  <div class="form-row">
    <div class="form-group form-group--wide">
      <label>Funder</label>
      <select name="funder_id">
        <option value="">— Select funder —</option>
        <% funders.forEach(function(f) { %>
          <option value="<%= f.id %>"><%= f.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label>Grant Number</label>
      <input type="text" name="grant_number">
    </div>
  </div>
  <div class="form-row">
    <div class="form-group form-group--wide">
      <label>Program Name</label>
      <input type="text" name="program_name">
    </div>
  </div>
  <div class="form-group">
    <label>Eligible Applicants</label>
    <textarea name="eligible_applicants" rows="2"></textarea>
  </div>
  <div class="form-row">
    <div class="form-group form-check">
      <label><input type="checkbox" name="match_required" value="1"> Match Required</label>
    </div>
    <div class="form-group">
      <label>Match % (if required)</label>
      <input type="number" name="match_percentage" min="0" max="100" step="0.1">
    </div>
    <div class="form-group form-group--wide">
      <label>Application Portal URL</label>
      <input type="url" name="application_portal">
    </div>
  </div>

  <div class="form-group">
    <label>Description / Notes</label>
    <textarea name="description" rows="5"></textarea>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save</button>
  </div>
</form>
