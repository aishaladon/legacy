<div class="page-header">
  <h2>All Opportunities</h2>
  <div style="display:flex;gap:.5rem;">
    <a href="/opportunities/evaluate" class="btn btn-secondary" title="Use AI to evaluate and score opportunities">🤖 AI Evaluate</a>
    <a href="/opportunities/new" class="btn btn-primary">+ Add</a>
  </div>
</div>
<p class="page-desc">Every contract, grant, and professional opportunity tracked in one place — from first discovery through award.</p>

<details class="how-to">
  <summary>How to use All Opportunities</summary>
  <div class="how-to-body">
    <ol>
      <li>Click <strong>+ Add</strong> to manually enter an opportunity, or use <strong>Email Inbox</strong> to import directly from BidMatch or GovExpert emails.</li>
      <li>Use the <strong>Type</strong> filter to separate government contracts, grants, subcontracts, and jobs. Use <strong>Status</strong> to focus on what's active.</li>
      <li>Click any opportunity title to open its detail page — this is where you add notes, link contacts and institutions, and move it into the Pipeline.</li>
      <li>Star important opportunities (&#9733;) to pin them to the top of the list.</li>
      <li>Once you decide to pursue, open the detail page and click <strong>Add to Pipeline</strong> to begin tracking stages and win probability.</li>
    </ol>
    <p>Statuses: <strong>New</strong> → just discovered &nbsp;|&nbsp; <strong>Reviewing</strong> → evaluating fit &nbsp;|&nbsp; <strong>Pursuing</strong> → actively working it &nbsp;|&nbsp; <strong>Submitted</strong> → proposal sent &nbsp;|&nbsp; <strong>Awarded / Not Pursuing / Closed</strong></p>
  </div>
</details>

<form class="filter-bar" method="GET" action="/opportunities">
  <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Search title…" class="filter-input">
  <select name="type" class="filter-select">
    <option value="">All Types</option>
    <% ['Government Contract','Grant','Job','Subcontract','Other'].forEach(function(t) { %>
      <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option>
    <% }); %>
  </select>
  <select name="status" class="filter-select">
    <option value="">All Statuses</option>
    <% ['New','Reviewing','Pursuing','Submitted','Awarded','Not Pursuing','Closed'].forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
  <a href="/opportunities" class="btn-link">Clear</a>
</form>

<% if (opportunities.length === 0) { %>
  <p class="empty-state">No opportunities found. <a href="/opportunities/new">Add one</a>.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th></th>
          <th>Title</th>
          <th>Type</th>
          <th>Due</th>
          <th>Amount</th>
          <th>Score</th>
          <th>Status</th>
          <th>Institution</th>
        </tr>
      </thead>
      <tbody>
        <% opportunities.forEach(function(o) { %>
          <tr>
            <td><% if (o.is_starred) { %><span class="star">&#9733;</span><% } %></td>
            <td><a href="/opportunities/<%= o.id %>"><%= o.title %></a></td>
            <td><span class="badge badge--<%= o.opportunity_type.toLowerCase().replace(' ','-') %>"><%= o.opportunity_type %></span></td>
            <td class="<%= o.due_date && new Date(o.due_date) < new Date(Date.now() + 14*86400000) ? 'due-date--urgent' : '' %>">
              <%= o.due_date ? new Date(o.due_date).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—' %>
            </td>
            <td>
              <% if (o.amount_max) { %>
                $<%= Number(o.amount_max).toLocaleString('en-US',{maximumFractionDigits:0}) %>
              <% } else if (o.amount_min) { %>
                $<%= Number(o.amount_min).toLocaleString('en-US',{maximumFractionDigits:0}) %>+
              <% } else { %> — <% } %>
            </td>
            <td><%= o.alignment_score ? Number(o.alignment_score).toFixed(1) : '—' %></td>
            <td><span class="badge badge--<%= o.status.toLowerCase().replace(' ','-') %>"><%= o.status %></span></td>
            <td><%= o.institution_name || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
