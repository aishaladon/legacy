<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Legacy GovCon</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('sidebar') %>
  <div class="main-wrap">
    <%
      const _path = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/';
      const _isTab = (prefix) => prefix === '/' ? _path === '/' : _path.indexOf(prefix) === 0;
      const _newRecordHref =
        _isTab('/contacts')     ? '/contacts/new' :
        _isTab('/institutions') ? '/institutions/new' :
        _isTab('/projects')     ? '/projects/new' :
        _isTab('/funders')      ? '/funders/new' :
        '/opportunities/new';
    %>
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle">&#9776;</button>
      <nav class="top-tabs">
        <a href="/" class="top-tab <%= _isTab('/') ? 'active' : '' %>">Dashboard</a>
        <a href="/opportunities" class="top-tab <%= _isTab('/opportunities') ? 'active' : '' %>">Opportunities</a>
        <a href="/contacts" class="top-tab <%= _isTab('/contacts') ? 'active' : '' %>">Contacts</a>
      </nav>
      <form action="/search" method="GET" class="topbar-search">
        <input type="text" name="q" placeholder="Search notices, agencies, NAICS, contacts&hellip;" class="input">
      </form>
      <a href="<%= _newRecordHref %>" class="btn btn-primary btn-sm">+ New record</a>
      <form action="/logout" method="POST" class="logout-form">
        <button type="submit" class="btn-link">Log out</button>
      </form>
    </header>

    <%
      const _now = new Date();
      const _m = _now.getMonth() + 1;
      const _fy = (_m >= 10 ? _now.getFullYear() + 1 : _now.getFullYear()) % 100;
      const _q = (_m >= 10) ? 1 : (_m <= 3) ? 2 : (_m <= 6) ? 3 : 4;
      const _dateStr = _now.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
      let _pipelineStr = '—';
      if (typeof dateline !== 'undefined' && dateline.pipelineValue !== null) {
        _pipelineStr = '$' + (dateline.pipelineValue / 1000000).toFixed(1) + 'M';
      }
      let _samStr = 'not synced yet';
      if (typeof dateline !== 'undefined' && dateline.samSync) {
        const _mins = Math.round((_now - new Date(dateline.samSync)) / 60000);
        _samStr = _mins < 1 ? 'just now' : _mins < 60 ? _mins + ' min ago' : _mins < 1440 ? Math.round(_mins / 60) + ' hr ago' : Math.round(_mins / 1440) + ' d ago';
      }
    %>
    <div class="dateline-rail">
      <span><%= _dateStr %></span>
      <span class="dateline-sep">|</span>
      <span>FY<%= _fy %> &middot; Q<%= _q %></span>
      <span class="dateline-sep">|</span>
      <span>Pipeline <%= _pipelineStr %></span>
      <span class="dateline-sep">|</span>
      <span>SAM.gov synced <%= _samStr %></span>
    </div>

    <main class="content">
      <% if (flash_success && flash_success.length) { %>
        <div class="flash flash-success"><%= flash_success[0] %></div>
      <% } %>
      <% if (flash_error && flash_error.length) { %>
        <div class="flash flash-error"><%= flash_error[0] %></div>
      <% } %>
      <% if (flash_info && flash_info.length) { %>
        <div class="flash flash-info"><%= flash_info[0] %></div>
      <% } %>

      <%- body %>
    </main>
    <footer class="app-footer">
      <span>System restarted: <%= new Date(serverStarted).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'}) %></span>
      <span>Legacy GovCon &mdash; Legacy P&amp;P Ltd.</span>
    </footer>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
