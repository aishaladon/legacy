<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Legacy GovCon</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('sidebar') %>
  <div class="main-wrap">
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle">&#9776;</button>
      <span class="topbar-title"><%= title %></span>
      <form action="/logout" method="POST" class="logout-form">
        <button type="submit" class="btn-link">Log out</button>
      </form>
    </header>

    <main class="content">
      <% if (flash_success && flash_success.length) { %>
        <div class="flash flash-success"><%= flash_success[0] %></div>
      <% } %>
      <% if (flash_error && flash_error.length) { %>
        <div class="flash flash-error"><%= flash_error[0] %></div>
      <% } %>
      <% if (flash_info && flash_info.length) { %>
        <div class="flash flash-info"><%= flash_info[0] %></div>
      <% } %>

      <%- body %>
    </main>
    <footer class="app-footer">
      <span>System restarted: <%= new Date(serverStarted).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'}) %></span>
      <span>Legacy GovCon &mdash; Legacy P&amp;P Ltd.</span>
    </footer>
  </div>
  <div id="claudeChat" class="claude-chat-panel">
    <div class="claude-chat-header">
      <span>Claude Assistant</span>
      <div class="claude-chat-header-actions">
        <button id="claudeChatClear" class="claude-chat-toggle" title="Clear conversation" type="button">&#8635;</button>
        <button id="claudeChatToggle" class="claude-chat-toggle" title="Close" type="button">&times;</button>
      </div>
    </div>
    <div id="claudeChatMessages" class="claude-chat-messages"></div>
    <div id="claudeAttachmentChip" class="claude-attachment-chip" style="display:none;">
      <span id="claudeAttachmentName"></span>
      <button id="claudeAttachmentRemove" type="button" title="Remove attachment">&times;</button>
    </div>
    <div class="claude-chat-input-area">
      <input type="file" id="claudeFileInput" accept=".txt,.pdf" style="display:none;">
      <button id="claudeAttachBtn" class="btn btn-secondary" type="button" title="Attach a .txt or .pdf file">&#128206;</button>
      <textarea id="claudeInput" placeholder="Ask Claude about this opportunity, copy/paste a bid, or get research..."></textarea>
      <button id="claudeSend" class="btn btn-primary">Send</button>
    </div>
  </div>
  <button id="claudeOpen" class="claude-chat-fab">Claude</button>

  <script src="/js/main.js"></script>
  <script src="/js/claude-chat.js"></script>
</body>
</html>
