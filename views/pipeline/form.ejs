<div class="page-header">
  <h2><%= title %></h2>
  <a href="/pipeline" class="btn-link">Cancel</a>
</div>

<div class="form-card">
  <p class="form-context">Opportunity: <strong><%= opp.title %></strong></p>

  <form action="/pipeline<%= item ? '/' + item.id + '/edit' : '' %>" method="POST">
    <% if (!item) { %>
      <input type="hidden" name="opportunity_id" value="<%= opp.id %>">
    <% } %>

    <div class="form-row">
      <div class="form-group">
        <label>Stage</label>
        <select name="stage">
          <% stages.forEach(function(s) { %>
            <option value="<%= s %>" <%= (item && item.stage === s) ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label>Probability (%)</label>
        <input type="number" name="probability" min="0" max="100" value="<%= item ? (item.probability || '') : '' %>">
      </div>
      <div class="form-group">
        <label>Expected Value ($)</label>
        <input type="number" name="expected_value" value="<%= item ? (item.expected_value || '') : '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group form-group--wide">
        <label>Next Action</label>
        <input type="text" name="next_action" value="<%= item ? (item.next_action || '') : '' %>">
      </div>
      <div class="form-group">
        <label>Next Action Date</label>
        <input type="date" name="next_action_date" value="<%= item && item.next_action_date ? new Date(item.next_action_date).toISOString().split('T')[0] : '' %>">
      </div>
    </div>

    <div class="form-group">
      <label>Go / No-Go Notes</label>
      <textarea name="go_no_go_notes" rows="4"><%= item ? (item.go_no_go_notes || '') : '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </form>
</div>
