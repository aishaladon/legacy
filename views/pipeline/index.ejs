<div class="page-header">
  <h2>Pipeline</h2>
  <p class="page-desc">Active pursuits staged through the BD lifecycle — track win probability, expected value, and next actions for every open opportunity.</p>
  <div class="stat-inline">
    <span><strong><%= totals.count || 0 %></strong> active</span>
    <span><strong>$<%= totals.total_value ? Number(totals.total_value).toLocaleString('en-US',{maximumFractionDigits:0}) : '0' %></strong> total value</span>
  </div>
</div>

<form class="filter-bar" method="GET" action="/pipeline">
  <select name="stage" class="filter-select">
    <option value="">Active Stages</option>
    <% stages.forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.stage === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
  <a href="/pipeline" class="btn-link">Clear</a>
</form>

<% if (items.length === 0) { %>
  <p class="empty-state">Nothing in the pipeline. Add opportunities to tracking from their detail page.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Opportunity</th>
          <th>Type</th>
          <th>Stage</th>
          <th>Prob.</th>
          <th>Expected Value</th>
          <th>Next Action</th>
          <th>Next Action Date</th>
          <th>Due</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(item) { %>
          <tr>
            <td><a href="/opportunities/<%= item.opportunity_id %>"><%= item.title %></a></td>
            <td><span class="badge badge--<%= item.opportunity_type.toLowerCase().replace(' ','-') %>"><%= item.opportunity_type %></span></td>
            <td><span class="badge"><%= item.stage %></span></td>
            <td><%= item.probability != null ? item.probability + '%' : '—' %></td>
            <td><%= item.expected_value ? '$' + Number(item.expected_value).toLocaleString('en-US',{maximumFractionDigits:0}) : '—' %></td>
            <td><%= item.next_action || '—' %></td>
            <td><%= item.next_action_date ? new Date(item.next_action_date).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '—' %></td>
            <td><%= item.due_date ? new Date(item.due_date).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '—' %></td>
            <td><a href="/pipeline/<%= item.id %>/edit" class="btn-link">Edit</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
