<div class="page-header">
  <h2>Projects</h2>
  <a href="/projects/new" class="btn btn-primary">+ Add</a>
</div>
<p class="page-desc">Awarded contracts and active engagements — track deliverables, timelines, contract values, and project status.</p>

<details class="how-to">
  <summary>How to use Projects</summary>
  <div class="how-to-body">
    <ol>
      <li>Projects are for <strong>work you've been awarded and are actively delivering</strong> — not pursuits. Move opportunities here once you win the contract or grant.</li>
      <li>Click <strong>+ Add</strong> to create a project. Link it to an institution and set the contract value, start date, and end date.</li>
      <li>Use <strong>Status</strong> to track delivery: Active → On Hold → Complete → Cancelled.</li>
      <li>Project records serve as your past performance history — include the contract number and agency/funder so you can reference them in future proposals.</li>
    </ol>
    <p>Tip: When a pipeline item is won, update the opportunity status to Awarded, then create a matching Project record to begin delivery tracking.</p>
  </div>
</details>

<form class="filter-bar" method="GET" action="/projects">
  <select name="status" class="filter-select">
    <option value="">All Statuses</option>
    <% ['Active','On Hold','Complete','Cancelled'].forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
  <a href="/projects" class="btn-link">Clear</a>
</form>

<% if (projects.length === 0) { %>
  <p class="empty-state">No projects yet.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Institution</th>
          <th>Value</th>
          <th>Start</th>
          <th>End</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% projects.forEach(function(p) { %>
          <tr>
            <td><a href="/projects/<%= p.id %>"><%= p.title %></a></td>
            <td><span class="badge badge--<%= p.project_type.toLowerCase().replace(' ','-') %>"><%= p.project_type %></span></td>
            <td><%= p.institution_name || '—' %></td>
            <td><%= p.contract_value ? '$' + Number(p.contract_value).toLocaleString('en-US',{maximumFractionDigits:0}) : '—' %></td>
            <td><%= p.start_date ? new Date(p.start_date).toLocaleDateString('en-US',{month:'short',year:'numeric',timeZone:'UTC'}) : '—' %></td>
            <td><%= p.end_date ? new Date(p.end_date).toLocaleDateString('en-US',{month:'short',year:'numeric',timeZone:'UTC'}) : '—' %></td>
            <td><span class="badge badge--<%= p.status.toLowerCase().replace(' ','-') %>"><%= p.status %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
