<div class="page-header">
  <h2>Projects</h2>
  <a href="/projects/new" class="btn btn-primary">+ Add</a>
</div>
<p class="page-desc">Awarded contracts and active engagements — track deliverables, timelines, contract values, and project status.</p>

<form class="filter-bar" method="GET" action="/projects">
  <select name="status" class="filter-select">
    <option value="">All Statuses</option>
    <% ['Active','On Hold','Complete','Cancelled'].forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
  <a href="/projects" class="btn-link">Clear</a>
</form>

<% if (projects.length === 0) { %>
  <p class="empty-state">No projects yet.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Institution</th>
          <th>Value</th>
          <th>Start</th>
          <th>End</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% projects.forEach(function(p) { %>
          <tr>
            <td><a href="/projects/<%= p.id %>"><%= p.title %></a></td>
            <td><span class="badge badge--<%= p.project_type.toLowerCase().replace(' ','-') %>"><%= p.project_type %></span></td>
            <td><%= p.institution_name || '—' %></td>
            <td><%= p.contract_value ? '$' + Number(p.contract_value).toLocaleString('en-US',{maximumFractionDigits:0}) : '—' %></td>
            <td><%= p.start_date ? new Date(p.start_date).toLocaleDateString('en-US',{month:'short',year:'numeric'}) : '—' %></td>
            <td><%= p.end_date ? new Date(p.end_date).toLocaleDateString('en-US',{month:'short',year:'numeric'}) : '—' %></td>
            <td><span class="badge badge--<%= p.status.toLowerCase().replace(' ','-') %>"><%= p.status %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
