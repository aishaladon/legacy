<div class="page-header">
  <h2>Settings</h2>
  <p class="page-desc">Your company profile, NAICS codes, tracked keywords, and notification preferences — configure how the system is tuned for your business.</p>
</div>

<section class="card" id="general">
  <h3>General Settings</h3>
  <form action="/settings/general" method="POST">
    <% const emailSettings = settings.filter(s => s.setting_type === 'Email');
       const textSettings  = settings.filter(s => s.setting_type === 'Text');
       const numSettings   = settings.filter(s => s.setting_type === 'Number');
       const listSettings  = settings.filter(s => s.setting_type === 'List'); %>

    <% if (emailSettings.length) { %><h4 class="settings-group-title">Email</h4><% } %>
    <% emailSettings.forEach(function(s) { %>
      <div class="form-group">
        <label for="s_<%= s.name %>"><%= s.description || s.name %></label>
        <input type="email" id="s_<%= s.name %>" name="<%= s.name %>" value="<%= s.value || '' %>">
      </div>
    <% }); %>

    <% if (textSettings.length) { %><h4 class="settings-group-title">Configuration</h4><% } %>
    <% textSettings.forEach(function(s) { %>
      <div class="form-group">
        <label for="s_<%= s.name %>"><%= s.description || s.name %></label>
        <input type="text" id="s_<%= s.name %>" name="<%= s.name %>" value="<%= s.value || '' %>">
      </div>
    <% }); %>

    <% if (numSettings.length) { %><h4 class="settings-group-title">Scoring &amp; Filters</h4><% } %>
    <% numSettings.forEach(function(s) { %>
      <div class="form-group">
        <label for="s_<%= s.name %>"><%= s.description || s.name %></label>
        <input type="number" id="s_<%= s.name %>" name="<%= s.name %>" value="<%= s.value || '' %>">
      </div>
    <% }); %>

    <% if (listSettings.length) { %><h4 class="settings-group-title">Lists</h4><% } %>
    <% listSettings.forEach(function(s) { %>
      <div class="form-group">
        <label for="s_<%= s.name %>"><%= s.description || s.name %></label>
        <input type="text" id="s_<%= s.name %>" name="<%= s.name %>" value="<%= s.value || '' %>" placeholder="Comma-separated">
      </div>
    <% }); %>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Settings</button>
    </div>
  </form>
</section>

<section class="card" id="keywords" style="margin-top:1.5rem">
  <div class="card-header">
    <h3>Keywords (<%= keywords.length %>)</h3>
  </div>
  <form action="/settings/keywords" method="POST" class="inline-form">
    <input type="text" name="keyword" placeholder="New keyword" required class="filter-input">
    <select name="priority" class="filter-select">
      <option value="High">High</option>
      <option value="Medium" selected>Medium</option>
      <option value="Low">Low</option>
    </select>
    <button type="submit" class="btn btn-secondary">Add</button>
  </form>
  <div class="table-wrap" style="margin-top:1rem">
    <table class="data-table">
      <thead><tr><th>Keyword</th><th>Priority</th><th></th></tr></thead>
      <tbody>
        <% keywords.forEach(function(k) { %>
          <tr>
            <td><%= k.keyword %></td>
            <td><span class="badge badge--<%= k.priority.toLowerCase() %>"><%= k.priority %></span></td>
            <td>
              <form action="/settings/keywords/<%= k.id %>/delete" method="POST" onsubmit="return confirm('Remove keyword?')">
                <button type="submit" class="btn-link btn-link--danger">Remove</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<section class="card" id="naics" style="margin-top:1.5rem">
  <h3>NAICS Codes</h3>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Code</th><th>Description</th><th>Primary</th><th></th></tr></thead>
      <tbody>
        <% naics.forEach(function(n) { %>
          <tr>
            <td><strong><%= n.code %></strong></td>
            <td><%= n.description %></td>
            <td><%= n.is_primary ? '★ Primary' : '—' %></td>
            <td>
              <form action="/settings/naics/<%= n.id %>/toggle" method="POST">
                <button type="submit" class="btn-link"><%= n.is_primary ? 'Unmark' : 'Mark Primary' %></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<section class="card" id="sources" style="margin-top:1.5rem">
  <h3>Data Sources</h3>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Name</th><th>Type</th><th>Status</th><th>Last Checked</th><th></th></tr></thead>
      <tbody>
        <% sources.forEach(function(s) { %>
          <tr>
            <td><%= s.name %></td>
            <td><%= s.source_type %></td>
            <td><span class="badge badge--<%= s.is_active ? 'active' : 'inactive' %>"><%= s.is_active ? 'Active' : 'Inactive' %></span></td>
            <td><%= s.last_checked ? new Date(s.last_checked).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) : 'Never' %></td>
            <td>
              <form action="/settings/sources/<%= s.id %>/toggle" method="POST">
                <button type="submit" class="btn-link"><%= s.is_active ? 'Disable' : 'Enable' %></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<section class="card" id="automations" style="margin-top:1.5rem">
  <h3>Automations</h3>
  <p style="font-size:.9rem;color:var(--text-muted);margin-bottom:1.25rem;">Automatically pull new opportunities from SAM.gov and Grants.gov each morning at 7 AM. New items are added directly to your Opportunities list with status "New". Uses the keywords from your Keywords list above.</p>

  <form action="/settings/automations" method="POST">
    <div class="auto-toggles">
      <div class="auto-toggle-row">
        <div>
          <strong>SAM.gov Daily Digest</strong>
          <div style="font-size:.82rem;color:var(--text-muted);margin-top:.2rem;">Pulls new contract solicitations, sources sought, and presolicitations posted in the last 24 hours. Requires a free SAM.gov API key set as <code>SAM_API_KEY</code> in Hostinger environment variables.</div>
        </div>
        <label class="toggle-switch">
          <input type="checkbox" name="auto_sam_enabled" value="1" <%= autoEnabled.sam ? 'checked' : '' %>>
          <span class="toggle-slider"></span>
        </label>
      </div>
      <div class="auto-toggle-row" style="margin-top:1rem;">
        <div>
          <strong>Grants.gov Daily Pull</strong>
          <div style="font-size:.82rem;color:var(--text-muted);margin-top:.2rem;">Pulls newly posted grants matching your keywords. No API key required — Grants.gov is publicly accessible.</div>
        </div>
        <label class="toggle-switch">
          <input type="checkbox" name="auto_grants_enabled" value="1" <%= autoEnabled.grants ? 'checked' : '' %>>
          <span class="toggle-slider"></span>
        </label>
      </div>
    </div>
    <div class="form-actions" style="margin-top:1rem;">
      <button type="submit" class="btn btn-primary">Save Automation Settings</button>
    </div>
  </form>

  <div style="margin-top:1.25rem;display:flex;gap:.75rem;flex-wrap:wrap;">
    <form action="/settings/run-sam" method="POST">
      <button type="submit" class="btn btn-secondary">Run SAM.gov Now</button>
    </form>
    <form action="/settings/run-grants" method="POST">
      <button type="submit" class="btn btn-secondary">Run Grants.gov Now</button>
    </form>
  </div>

  <% if (autoLogs.length > 0) { %>
    <h4 style="margin-top:1.5rem;font-size:.85rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);">Recent Automation Runs</h4>
    <div class="table-wrap" style="margin-top:.5rem">
      <table class="data-table">
        <thead><tr><th>Type</th><th>Status</th><th>Found</th><th>New</th><th>Message</th><th>Ran At</th></tr></thead>
        <tbody>
          <% autoLogs.forEach(function(log) { %>
            <tr>
              <td><%= log.run_type === 'sam_digest' ? 'SAM.gov' : 'Grants.gov' %></td>
              <td><span class="badge badge--<%= log.status %>"><%= log.status %></span></td>
              <td><%= log.items_found || 0 %></td>
              <td><%= log.items_new || 0 %></td>
              <td style="font-size:.8rem;color:var(--text-muted);max-width:300px;white-space:normal;"><%= log.message || '' %></td>
              <td style="font-size:.8rem;white-space:nowrap;"><%= new Date(log.ran_at).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p style="margin-top:1rem;font-size:.85rem;color:var(--text-muted);">No automation runs yet. Click "Run Now" to test, or enable the toggles to start the daily schedule.</p>
  <% } %>
</section>

<section class="card" id="seed" style="margin-top:1.5rem">
  <h3>Starter Data</h3>
  <p style="font-size:.9rem;color:var(--text-muted);margin-bottom:1rem;">Load a curated list of target institutions — federal agencies (NARA, NEH, NEA, NPS, IMLS), Smithsonian museums, African American history museums, HBCUs, and key historical societies. Safe to run more than once; existing institutions are skipped.</p>
  <form action="/settings/seed-institutions" method="POST" onsubmit="return confirm('This will add ~55 starter institutions to your list. Continue?')">
    <button type="submit" class="btn btn-secondary">Load Starter Institutions (~55 orgs)</button>
  </form>
</section>
