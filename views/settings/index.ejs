<div class="page-header">
  <h2>Settings</h2>
  <p class="page-desc">Your company profile, NAICS codes, tracked keywords, and notification preferences — configure how the system is tuned for your business.</p>
</div>

<% function pv(name) { const s = profileSettings.find(x => x.name === name); return (s && s.value) || ''; } %>

<section class="card" id="profile">
  <h3>Company Profile</h3>
  <p style="font-size:.9rem;color:var(--text-muted);margin-bottom:1.25rem;">Who you are, for AI drafts (proposals, outreach emails) and Claude's opportunity evaluations to reference.</p>

  <div class="profile-logo-row">
    <div class="profile-logo-preview">
      <% if (logoPath) { %>
        <img src="<%= logoPath %>" alt="Company logo">
      <% } else { %>
        <span class="profile-logo-placeholder">No logo</span>
      <% } %>
    </div>
    <form action="/settings/logo" method="POST" enctype="multipart/form-data" class="profile-logo-form">
      <label style="font-weight:600;font-size:.85rem;">Logo</label>
      <input type="file" name="logo" accept=".png,.jpg,.jpeg,.svg,.webp">
      <span style="font-size:.78rem;color:var(--text-muted);">PNG, JPG, SVG, or WebP. Max 5 MB.</span>
      <button type="submit" class="btn btn-secondary btn-sm">Upload Logo</button>
    </form>
  </div>

  <form action="/settings/company-profile" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label>Business Name</label>
        <input type="text" name="company_business_name" value="<%= pv('company_business_name') %>">
      </div>
      <div class="form-group">
        <label>Owner's Name</label>
        <input type="text" name="company_owner_name" value="<%= pv('company_owner_name') %>">
      </div>
      <div class="form-group">
        <label>Years in Business</label>
        <input type="number" name="company_years_in_business" value="<%= pv('company_years_in_business') %>" style="width:8rem;">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group form-group--wide">
        <label>Website</label>
        <input type="text" name="company_website" value="<%= pv('company_website') %>" placeholder="https://…">
      </div>
      <div class="form-group">
        <label>CAGE Code</label>
        <input type="text" name="company_cage" value="<%= pv('company_cage') %>">
      </div>
      <div class="form-group">
        <label>UEI</label>
        <input type="text" name="company_uei" value="<%= pv('company_uei') %>">
      </div>
    </div>
    <div class="form-group">
      <label>Certifications</label>
      <input type="text" name="company_certifications" value="<%= pv('company_certifications') %>" placeholder="e.g. WOSB, EDWOSB, MBE">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Company Profile</button>
    </div>
  </form>

  <hr style="margin:1.5rem 0;border:none;border-top:1px solid var(--border);">

  <h4 class="settings-group-title" style="margin-bottom:.5rem;">Capability Statement</h4>
  <p style="font-size:.85rem;color:var(--text-muted);margin-bottom:.75rem;">
    This is what Claude reads for opportunity fit evaluations, RFP responses, and outreach email drafts. Edit directly below, or upload a file to replace it — uploading also suggests keywords and NAICS codes based on what it says.
  </p>
  <form action="/settings/capability-statement" method="POST">
    <div class="form-group">
      <textarea name="content" rows="10" style="width:100%;font-family:inherit;font-size:.9rem;" placeholder="Paste or write your capability statement here…"><%= capabilityStatement ? capabilityStatement.content : '' %></textarea>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-secondary">Save Capability Statement</button>
    </div>
  </form>
  <form action="/settings/capability-statement-upload" method="POST" enctype="multipart/form-data" style="margin-top:.85rem;display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;">
    <input type="file" name="file" accept=".txt,.pdf,.docx" required>
    <button type="submit" class="btn btn-secondary btn-sm">Upload &amp; Suggest Keywords/NAICS</button>
    <span style="font-size:.78rem;color:var(--text-muted);">.txt, .pdf, or .docx — replaces the text above</span>
  </form>
</section>

<section class="card" id="general" style="margin-top:1.5rem">
  <h3>General Settings</h3>
  <form action="/settings/general" method="POST">
    <% const emailSettings = settings.filter(s => s.setting_type === 'Email');
       const textSettings  = settings.filter(s => s.setting_type === 'Text' && !['backup_frequency','backup_destination'].includes(s.name));
       const numSettings   = settings.filter(s => s.setting_type === 'Number');
       const listSettings  = settings.filter(s => s.setting_type === 'List'); %>

    <% if (emailSettings.length) { %><h4 class="settings-group-title">Email</h4><% } %>
    <% emailSettings.forEach(function(s) { %>
      <div class="form-group">
        <label for="s_<%= s.name %>"><%= s.description || s.name %></label>
        <input type="email" id="s_<%= s.name %>" name="<%= s.name %>" value="<%= s.value || '' %>">
      </div>
    <% }); %>

    <% if (textSettings.length) { %><h4 class="settings-group-title">Configuration</h4><% } %>
    <% textSettings.forEach(function(s) { %>
      <div class="form-group">
        <label for="s_<%= s.name %>"><%= s.description || s.name %></label>
        <input type="text" id="s_<%= s.name %>" name="<%= s.name %>" value="<%= s.value || '' %>">
      </div>
    <% }); %>

    <% if (numSettings.length) { %><h4 class="settings-group-title">Scoring &amp; Filters</h4><% } %>
    <% numSettings.forEach(function(s) { %>
      <div class="form-group">
        <label for="s_<%= s.name %>"><%= s.description || s.name %></label>
        <input type="number" id="s_<%= s.name %>" name="<%= s.name %>" value="<%= s.value || '' %>">
      </div>
    <% }); %>

    <% if (listSettings.length) { %><h4 class="settings-group-title">Lists</h4><% } %>
    <% listSettings.forEach(function(s) { %>
      <div class="form-group">
        <label for="s_<%= s.name %>"><%= s.description || s.name %></label>
        <input type="text" id="s_<%= s.name %>" name="<%= s.name %>" value="<%= s.value || '' %>" placeholder="Comma-separated">
      </div>
    <% }); %>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Settings</button>
    </div>
  </form>
</section>

<section class="card" id="api-keys" style="margin-top:1.5rem">
  <h3>API Keys</h3>
  <p style="font-size:.9rem;color:var(--text-muted);margin-bottom:1rem;">Store your API keys here. They're used by Claude Assistant and other integrations. Never share these keys.</p>

  <form action="/settings/api-keys" method="POST">
    <div class="form-group">
      <label for="claude_api_key">Claude API Key</label>
      <input type="password" id="claude_api_key" name="claude_api_key" placeholder="sk-ant-..." value="<%= claudeApiKey || '' %>" style="font-family:monospace;font-size:.9rem;">
      <div style="font-size:.8rem;color:var(--text-muted);margin-top:.3rem;">
        Get your API key from <a href="https://console.anthropic.com/account/keys" target="_blank" rel="noopener">console.anthropic.com/account/keys</a>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save API Key</button>
    </div>
  </form>
  <% if (claudeApiKey) { %>
    <div style="margin-top:1rem;padding:.75rem;background:#f0f7ff;border-left:3px solid #0066cc;border-radius:4px;font-size:.85rem;">
      ✓ Claude API key is set and ready to use.
    </div>
  <% } %>
</section>

<section class="card" id="keywords" style="margin-top:1.5rem">
  <div class="card-header">
    <h3>Keywords (<%= keywords.length %>)</h3>
  </div>
  <form action="/settings/keywords" method="POST" class="inline-form">
    <input type="text" name="keyword" placeholder="New keyword" required class="filter-input">
    <select name="priority" class="filter-select">
      <option value="High">High</option>
      <option value="Medium" selected>Medium</option>
      <option value="Low">Low</option>
    </select>
    <button type="submit" class="btn btn-secondary">Add</button>
  </form>
  <div class="table-wrap" style="margin-top:1rem">
    <table class="data-table">
      <thead><tr><th>Keyword</th><th>Priority</th><th></th></tr></thead>
      <tbody>
        <% keywords.forEach(function(k) { %>
          <tr>
            <td><%= k.keyword %></td>
            <td><span class="badge badge--<%= k.priority.toLowerCase() %>"><%= k.priority %></span></td>
            <td>
              <form action="/settings/keywords/<%= k.id %>/delete" method="POST" onsubmit="return confirm('Remove keyword?')">
                <button type="submit" class="btn-link btn-link--danger">Remove</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<section class="card" id="naics" style="margin-top:1.5rem">
  <h3>NAICS Codes</h3>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Code</th><th>Description</th><th>Primary</th><th></th></tr></thead>
      <tbody>
        <% naics.forEach(function(n) { %>
          <tr>
            <td><strong><%= n.code %></strong></td>
            <td><%= n.description %></td>
            <td><%= n.is_primary ? '★ Primary' : '—' %></td>
            <td>
              <form action="/settings/naics/<%= n.id %>/toggle" method="POST">
                <button type="submit" class="btn-link"><%= n.is_primary ? 'Unmark' : 'Mark Primary' %></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<section class="card" id="sources" style="margin-top:1.5rem">
  <h3>Data Sources</h3>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Name</th><th>Type</th><th>Status</th><th>Last Checked</th><th></th></tr></thead>
      <tbody>
        <% sources.forEach(function(s) { %>
          <tr>
            <td><%= s.name %></td>
            <td><%= s.source_type %></td>
            <td><span class="badge badge--<%= s.is_active ? 'active' : 'inactive' %>"><%= s.is_active ? 'Active' : 'Inactive' %></span></td>
            <td><%= s.last_checked ? new Date(s.last_checked).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) : 'Never' %></td>
            <td>
              <form action="/settings/sources/<%= s.id %>/toggle" method="POST">
                <button type="submit" class="btn-link"><%= s.is_active ? 'Disable' : 'Enable' %></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<section class="card" id="automations" style="margin-top:1.5rem">
  <h3>Automations</h3>
  <p style="font-size:.9rem;color:var(--text-muted);margin-bottom:1.25rem;">Automatically pull new opportunities from SAM.gov and Grants.gov each morning at 7 AM. New items are added directly to your Opportunities list with status "New". Uses the keywords from your Keywords list above.</p>

  <form action="/settings/automations" method="POST">
    <div class="auto-toggles">
      <div class="auto-toggle-row">
        <div>
          <strong>SAM.gov Daily Digest</strong>
          <div style="font-size:.82rem;color:var(--text-muted);margin-top:.2rem;">Pulls new contract solicitations, sources sought, and presolicitations posted in the last 24 hours. Requires a free SAM.gov API key set as <code>SAM_API_KEY</code> in Hostinger environment variables.</div>
        </div>
        <label class="toggle-switch">
          <input type="checkbox" name="auto_sam_enabled" value="1" <%= autoEnabled.sam ? 'checked' : '' %>>
          <span class="toggle-slider"></span>
        </label>
      </div>
      <div class="auto-toggle-row" style="margin-top:1rem;">
        <div>
          <strong>Grants.gov Daily Pull</strong>
          <div style="font-size:.82rem;color:var(--text-muted);margin-top:.2rem;">Pulls newly posted grants matching your keywords. No API key required — Grants.gov is publicly accessible.</div>
        </div>
        <label class="toggle-switch">
          <input type="checkbox" name="auto_grants_enabled" value="1" <%= autoEnabled.grants ? 'checked' : '' %>>
          <span class="toggle-slider"></span>
        </label>
      </div>
      <div class="auto-toggle-row" style="margin-top:1rem;">
        <div>
          <strong>Daily Opportunity Digest</strong>
          <div style="font-size:.82rem;color:var(--text-muted);margin-top:.2rem;">
            Emails a summary of opportunities added to govcon in the last 24 hours, filtered by your Minimum Contract Amount and Minimum Alignment Score settings above.
            Sent to <strong><%= settings.find(s => s.name === 'digest_email_address') && settings.find(s => s.name === 'digest_email_address').value || '(not set — see General Settings)' %></strong>
            around <strong><%= settings.find(s => s.name === 'digest_delivery_time') && settings.find(s => s.name === 'digest_delivery_time').value || '07:00' %></strong>.
            Requires <code>SMTP_HOST</code>, <code>SMTP_USERNAME</code>, and <code>SMTP_PASSWORD</code> set in Hostinger environment variables.
          </div>
        </div>
        <label class="toggle-switch">
          <input type="checkbox" name="auto_digest_enabled" value="1" <%= autoEnabled.digest ? 'checked' : '' %>>
          <span class="toggle-slider"></span>
        </label>
      </div>
    </div>
    <div class="form-actions" style="margin-top:1rem;">
      <button type="submit" class="btn btn-primary">Save Automation Settings</button>
    </div>
  </form>

  <div style="margin-top:1.25rem;display:flex;gap:.75rem;flex-wrap:wrap;">
    <form action="/settings/run-sam" method="POST">
      <button type="submit" class="btn btn-secondary">Run SAM.gov Now</button>
    </form>
    <form action="/settings/run-grants" method="POST">
      <button type="submit" class="btn btn-secondary">Run Grants.gov Now</button>
    </form>
    <form action="/settings/run-digest" method="POST">
      <button type="submit" class="btn btn-secondary">Send Digest Now</button>
    </form>
    <form action="/settings/rescore" method="POST">
      <button type="submit" class="btn btn-secondary">Recalculate Scores</button>
    </form>
    <a href="/digest-log" class="btn btn-secondary">View Digest Log</a>
  </div>

  <% if (autoLogs.length > 0) { %>
    <h4 style="margin-top:1.5rem;font-size:.85rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);">Recent Automation Runs</h4>
    <div class="table-wrap" style="margin-top:.5rem">
      <table class="data-table">
        <thead><tr><th>Type</th><th>Status</th><th>Found</th><th>New</th><th>Message</th><th>Ran At</th></tr></thead>
        <tbody>
          <% autoLogs.forEach(function(log) { %>
            <tr>
              <td><%= { sam_digest: 'SAM.gov', grants_pull: 'Grants.gov', backup: 'Backup' }[log.run_type] || log.run_type %></td>
              <td><span class="badge badge--<%= log.status %>"><%= log.status %></span></td>
              <td><%= log.items_found || 0 %></td>
              <td><%= log.items_new || 0 %></td>
              <td style="font-size:.8rem;color:var(--text-muted);max-width:300px;white-space:normal;"><%= log.message || '' %></td>
              <td style="font-size:.8rem;white-space:nowrap;"><%= new Date(log.ran_at).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p style="margin-top:1rem;font-size:.85rem;color:var(--text-muted);">No SAM.gov or Grants.gov pull runs yet. Click "Run Now" to test, or enable the toggles above to start the daily schedule. (Digest email attempts are logged separately — see <a href="/digest-log">Digest Log</a>.)</p>
  <% } %>
</section>

<section class="card" id="backup" style="margin-top:1.5rem">
  <h3>Backup</h3>
  <p style="font-size:.9rem;color:var(--text-muted);margin-bottom:1.25rem;">
    A full copy of your database — every opportunity, contact, institution, and setting — as a <code>.sql</code> file inside a <code>.zip</code> archive. To restore: unzip it, then in Hostinger hPanel go to Databases → phpMyAdmin, select this database, open the Import tab, choose the <code>.sql</code> file, and click Go. Restoring replaces current data with what's in the backup — it does not merge.
  </p>

  <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-bottom:1.25rem;">
    <a href="/settings/backup-download" class="btn btn-secondary">Download Backup Now</a>
    <form action="/settings/run-backup" method="POST">
      <button type="submit" class="btn btn-secondary">Email Backup Now</button>
    </form>
  </div>

  <form action="/settings/general" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label for="backup_frequency">Backup Frequency</label>
        <select id="backup_frequency" name="backup_frequency">
          <% const bf = (settings.find(s => s.name === 'backup_frequency') || {}).value || 'daily'; %>
          <option value="daily" <%= bf === 'daily' ? 'selected' : '' %>>Daily (around 3 AM)</option>
          <option value="weekly" <%= bf === 'weekly' ? 'selected' : '' %>>Weekly (Sunday, around 3 AM)</option>
          <option value="never" <%= (bf === 'never' || bf === 'off') ? 'selected' : '' %>>Never (manual only)</option>
        </select>
      </div>
      <div class="form-group form-group--wide">
        <label for="backup_destination">Backup Email Address</label>
        <input type="email" id="backup_destination" name="backup_destination" value="<%= (settings.find(s => s.name === 'backup_destination') || {}).value || '' %>" placeholder="you@example.com">
        <span style="font-size:.78rem;color:var(--text-muted);">Where scheduled backups are emailed. Requires <code>SMTP_HOST</code>, <code>SMTP_USERNAME</code>, and <code>SMTP_PASSWORD</code> set in Hostinger environment variables.</span>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Backup Settings</button>
    </div>
  </form>
</section>

<section class="card" id="seed" style="margin-top:1.5rem">
  <h3>Starter Data</h3>
  <p style="font-size:.9rem;color:var(--text-muted);margin-bottom:1rem;">Load curated lists of target institutions. Safe to run more than once — existing institutions are skipped.</p>
  <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
    <form action="/settings/seed-institutions" method="POST" onsubmit="return confirm('This will add ~55 starter institutions to your list. Continue?')">
      <button type="submit" class="btn btn-secondary">Load Starter Institutions (~55 orgs)</button>
    </form>
    <form action="/settings/seed-aa-museums" method="POST" onsubmit="return confirm('This will add ~120 African American museums and cultural institutions to your list. Continue?')">
      <button type="submit" class="btn btn-secondary">Load African American Museums &amp; Cultural Institutions (~120 orgs)</button>
    </form>
  </div>
  <p style="font-size:.8rem;color:var(--text-muted);margin-top:.6rem;">African American list includes museums, archives, cultural centers, HBCUs, and historic sites from Alabama through Wisconsin plus national organizations.</p>
</section>

<section class="card" id="import" style="margin-top:1.5rem">
  <h3>Import Institutions from CSV</h3>
  <p style="font-size:.9rem;color:var(--text-muted);margin-bottom:.75rem;">
    Upload a CSV file or paste CSV text to bulk-import institutions. Existing institutions (matched by name) are skipped.
    Required column: <code>name</code>. Optional: <code>institution_type</code>, <code>city</code>, <code>state</code>, <code>website</code>, <code>relationship_status</code>, <code>notes</code>.
  </p>
  <details style="margin-bottom:.85rem;">
    <summary style="font-size:.85rem;cursor:pointer;color:var(--text-muted);">Show CSV template / column format</summary>
    <pre style="font-size:.78rem;background:var(--bg-subtle,#f5f5f5);padding:.6rem .85rem;border-radius:4px;margin-top:.4rem;overflow-x:auto;">name,institution_type,city,state,website,relationship_status,notes
National Archives,Federal Agency,Washington,DC,https://archives.gov,Target,Main federal archive
Example Museum,Museum,Chicago,IL,https://example.org,Prospect,University affiliated</pre>
  </details>
  <form action="/settings/import-institutions-csv" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label for="csv_file" style="font-weight:600;">Upload CSV file</label>
      <input type="file" id="csv_file" name="csv_file" accept=".csv,text/csv,text/plain" style="display:block;margin-top:.35rem;">
      <span style="font-size:.8rem;color:var(--text-muted);">Max 5 MB. Accepted: .csv or .txt</span>
    </div>
    <div style="text-align:center;margin:.6rem 0;font-size:.85rem;color:var(--text-muted);">— or paste CSV text below —</div>
    <div class="form-group">
      <textarea name="csv_data" rows="8" placeholder="Paste CSV here (first row must be column headers)…" style="width:100%;font-family:monospace;font-size:.82rem;resize:vertical;"></textarea>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Import CSV</button>
    </div>
  </form>
</section>
